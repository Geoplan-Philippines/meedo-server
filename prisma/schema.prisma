// Notes for AI / Contributors:
// For fucks sake dipshit,
// Follow existing formatting, (alignment, spacing, ordering)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                            String                    @id @default(uuid())
  name                          String?
  email                         String                    @unique
  emailVerified                 Boolean                   @default(false) @map("is_email_verified")
  image                         String?                   @map("image_url")
  employeeCode                  String?                   @unique @map("employee_code")
  biometricsId                  String?                   @unique @map("biometrics_id")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  accounts                      Account[]
  attendanceEvents              AttendanceEvent[]
  attendances                   Attendance[]
  faceProfiles                  FaceProfile[]
  invitations                   Invitation[]
  members                       Member[]
  sessions                      Session[]
  teamMembers                   TeamMember[]
  timesheetEntries              TimesheetEntry[]
  timesheetAuditTargets         TimesheetAuditLog[]       @relation("TimesheetAuditTargetUser")
  scheduleAssignments           EmployeeScheduleAssignment[]

  @@map("users")
}

model Session {
  id                            String                    @id @default(uuid())
  expiresAt                     DateTime                  @map("expires_at")
  token                         String                    @unique
  ipAddress                     String?                   @map("ip_address")
  userAgent                     String?                   @map("user_agent")
  activeOrganizationId          String?                   @map("active_organization_id")
  activeTeamId                  String?                   @map("active_team_id")

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")


  @@index([userId])
  @@map("sessions")
}

model Account {
  id                            String                    @id @default(uuid())
  accountId                     String                    @map("account_id")
  providerId                    String                    @map("provider_id")
  accessToken                   String?                   @map("access_token")
  refreshToken                  String?                   @map("refresh_token")
  idToken                       String?                   @map("id_token")
  accessTokenExpiresAt          DateTime?                 @map("access_token_expires_at")
  refreshTokenExpiresAt         DateTime?                 @map("refresh_token_expires_at")
  scope                         String?
  password                      String?

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id                            String                    @id @default(uuid())
  identifier                    String
  value                         String
  expiresAt                     DateTime                  @map("expires_at")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id                            String                    @id @default(uuid())
  name                          String
  slug                          String                    @unique
  prefix                        String?                   @unique
  logo                          String?
  metadata                      String?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  faceEmbeddings                FaceEmbedding[]
  faceProfiles                  FaceProfile[]
  invitations                   Invitation[]
  members                       Member[]
  ticketStatuses                TicketStatus[]
  ticketCategories              TicketCategory[]
  teams                         Team[]
  tickets                       Tickets[]
  projects                      Project[]
  slaPolicies                   SlaPolicy[]
  timesheetEntries              TimesheetEntry[]
  timesheetPeriodLocks          TimesheetPeriodLock[]
  timesheetAuditLogs            TimesheetAuditLog[]
  attendancePolicy              AttendancePolicy?
  shifts                        Shift[]
  weeklySchedules               WeeklySchedule[]
  holidays                      Holiday[]
  teamScheduleAssignments       TeamScheduleAssignment[]
  employeeScheduleAssignments   EmployeeScheduleAssignment[]
  clients                       Client[]

  @@map("organizations")
}

model Team {
  id                            String                    @id @default(uuid())
  name                          String

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  teamMembers                   TeamMember[]
  invitations                   Invitation[]
  tickets                       Tickets[]
  scheduleAssignment            TeamScheduleAssignment?

  @@map("teams")
  @@index([organizationId])
  @@unique([organizationId, name])
}

model TeamMember {
  id                            String                    @id @default(uuid())

  teamId                        String                    @map("team_id")
  team                          Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Member {
  id                            String                    @id @default(uuid())
  role                          String                    @default("member")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  ticketAssignees               TicketAssignee[]
  ticketComments                TicketComment[]
  ticketActivities              TicketActivity[]
  approvedTimesheetEntries      TimesheetEntry[]          @relation("TimesheetEntryApprovedBy")
  rejectedTimesheetEntries      TimesheetEntry[]          @relation("TimesheetEntryRejectedBy")
  lockedTimesheetPeriods        TimesheetPeriodLock[]     @relation("TimesheetPeriodLockedBy")
  unlockedTimesheetPeriods      TimesheetPeriodLock[]     @relation("TimesheetPeriodUnlockedBy")
  timesheetAuditLogs            TimesheetAuditLog[]       @relation("TimesheetAuditActor")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id                            String                    @id @default(uuid())
  email                         String
  role                          String?
  status                        String                    @default("pending")
  expiresAt                     DateTime                  @map("expires_at")

  inviterId                     String                    @map("inviter_id")
  user                          User                      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId                        String?                   @map("team_id")
  team                          Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([email])
  @@index([teamId])
  @@map("invitations")
}

model FaceProfile {
  id                            String                    @id @default(uuid())
  status                        FaceProfileStatus         @default(PENDING)
  enrolledAt                    DateTime?                 @default(now()) @map("enrolled_at")
  disabledAt                    DateTime?                 @map("disabled_at")
  isArchived                    Boolean                   @default(false) @map("is_archived")
  organizationId                String                    @map("organization_id")
  userId                        String                    @map("user_id")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  faceEmbeddings                FaceEmbedding[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("face_profiles")
}

model FaceEmbedding {
  id                            String                    @id @default(uuid())
  provider                      FaceEmbeddingProvider     @default(DEEPFACE)
  model                         FaceEmbeddingModel
  embedding                     Unsupported("vector")
  imageUrl                      String?                   @map("image_url")
  qualityScore                  Float?                    @map("quality_score")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  faceProfileId                 String                    @map("face_profile_id")
  faceProfile                   FaceProfile               @relation(fields: [faceProfileId], references: [id], onDelete: Cascade)

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([faceProfileId])
  @@index([provider, model])
  @@index([isArchived])
  @@map("face_embeddings")
}

model TicketCategory {
  id                            String                    @id @default(uuid())
  name                          String
  description                   String?

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets                      Tickets[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("ticket_categories")
  @@index([organizationId])
  @@unique([organizationId, name])
}

model NewsletterSubscriber {
  id                            String                    @id @default(uuid())
  email                         String                    @unique
  name                          String?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

model Project {
  id                            String                    @id @default(uuid())
  workOrderNumber               String                    @map("work_order_number")
  customerName                  String                    @default("") @map("customer_name")
  status                        String
  total                         Float
  reportedDate                  DateTime?                 @map("reported_date")

  apptivoId                     String                    @map("apptivo_id")
  organizationId                String                    @map("organization_id")
  clientId                      String?                   @map("client_id")

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                        Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tickets                       Tickets[]
  slaPolicies                   SlaPolicy[]
  timesheetEntries              TimesheetEntry[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, apptivoId])
  @@index([organizationId])
  @@index([clientId])
  @@map("projects")
}

model Client {
  id                            String                    @id @default(uuid())
  apptivoId                     String                    @map("apptivo_id")
  customerName                  String                    @map("customer_name")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects                      Project[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, apptivoId])
  @@unique([organizationId, customerName])
  @@index([organizationId])
  @@map("clients")
}

model Lead {
  id                            String                    @id @default(uuid())
  firstName                     String                    @map("first_name")
  lastName                      String                    @map("last_name")
  email                         String                    @unique
  company                       String?
  phoneNumber                   String?                   @map("phone_number")
  status                        LeadStatus                @default(PENDING)
  message                       String

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("leads")
}

enum TicketStatusCategory {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED
}

model TicketStatus {
  id                            String                    @id @default(uuid())
  name                          String
  color                         String?                   @default("#6B7280")
  category                      TicketStatusCategory      @default(BACKLOG)
  isArchived                    Boolean                   @default(false) @map("is_archived")
  isSystem                      Boolean                   @default(false) @map("is_system")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets                       Tickets[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([category])
  @@map("ticket_status")
}

model Tickets {
  id                            String                    @id @default(uuid())
  ticketNumber                  Int                       @map("ticket_number")
  title                         String
  description                   String?
  priority                      TicketPriority            @default(MEDIUM)
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  teamId                        String?                   @map("team_id")
  projectId                     String?                   @map("project_id")
  categoryId                    String?                   @map("category_id")
  ticketStatusId                String?                   @map("ticket_status_id")

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                       Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team                          Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignees                     TicketAssignee[]
  comments                      TicketComment[]
  activities                    TicketActivity[]
  relatedTickets                TicketRelation[]          @relation("TicketRelationSource")
  relatedFrom                   TicketRelation[]          @relation("TicketRelationTarget")

  ticketStatus                  TicketStatus?             @relation(fields: [ticketStatusId], references: [id], onDelete: SetNull)
  category                      TicketCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  firstRespondedAt              DateTime?                 @map("first_responded_at")
  resolvedAt                    DateTime?                 @map("resolved_at")
  dueDate                       DateTime?                 @map("due_date")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([ticketStatusId])
  @@index([categoryId])
  @@index([projectId])
  @@index([teamId])
  @@index([isArchived])
  @@unique([organizationId, ticketNumber])
  @@map("tickets")
}

model TicketAssignee {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  memberId                      String                    @map("member_id")
  member                        Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([ticketId, memberId])
  @@index([ticketId])
  @@index([memberId])
  @@map("ticket_assignees")
}

// A directed link between two tickets. Relations are symmetric: linking A→B always
// mirrors a B→A row, so either ticket surfaces the other and unlinking clears both.
model TicketRelation {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation("TicketRelationSource", fields: [ticketId], references: [id], onDelete: Cascade)

  relatedTicketId               String                    @map("related_ticket_id")
  relatedTicket                 Tickets                   @relation("TicketRelationTarget", fields: [relatedTicketId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")

  @@unique([ticketId, relatedTicketId])
  @@index([ticketId])
  @@index([relatedTicketId])
  @@map("ticket_relations")
}

model SlaPolicy {
  id                            String                    @id @default(uuid())
  name                          String                    @db.VarChar(150)
  documentUrl                   String?                   @map("document_url") @db.VarChar(500)
  priority                      TicketPriority
  firstResponseMinutes          Int                       @map("first_response_minutes")
  resolutionMinutes             Int                       @map("resolution_minutes")
  businessHoursOnly             Boolean                   @default(false) @map("business_hours_only")
  isActive                      Boolean                   @default(true) @map("is_active")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId                     String?                   @map("project_id")
  project                       Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([isActive])
  @@index([isArchived])
  @@map("sla_policies")
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  COMMENTED
  ARCHIVED
  RESTORED
}

model TicketComment {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorMemberId                String?                   @map("author_member_id")
  author                        Member?                   @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)

  // One level of threaded replies: a reply points at its top-level parent.
  parentId                      String?                   @map("parent_id")
  parent                        TicketComment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies                       TicketComment[]           @relation("CommentReplies")

  body                          String

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([authorMemberId])
  @@index([parentId])
  @@map("ticket_comments")
}

model TicketActivity {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorMemberId                 String?                   @map("actor_member_id")
  actor                         Member?                   @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  type                          TicketActivityType
  meta                          Json?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([actorMemberId])
  @@map("ticket_activities")
}

model TimesheetEntry {
  id                            String                    @id @default(uuid())

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId                     String                    @map("project_id")
  project                       Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  workDate                      DateTime                  @map("work_date")
  hours                         Float
  location                      String                    @default("OFC - DW")
  workType                      TimesheetWorkType         @default(REGULAR) @map("work_type")
  task                          String
  projectDescription            String?                   @map("project_description")
  isOvertime                    Boolean                   @default(false) @map("is_overtime")
  isNightDifferential           Boolean                   @default(false) @map("is_night_differential")
  status                        TimesheetEntryStatus      @default(DRAFT)
  submittedAt                   DateTime?                 @map("submitted_at")
  approvedAt                    DateTime?                 @map("approved_at")
  approvedByMemberId            String?                   @map("approved_by_member_id")
  approvedBy                    Member?                   @relation("TimesheetEntryApprovedBy", fields: [approvedByMemberId], references: [id], onDelete: SetNull)
  rejectedAt                    DateTime?                 @map("rejected_at")
  rejectedByMemberId            String?                   @map("rejected_by_member_id")
  rejectedBy                    Member?                   @relation("TimesheetEntryRejectedBy", fields: [rejectedByMemberId], references: [id], onDelete: SetNull)
  rejectionReason               String?                   @map("rejection_reason")

  auditLogs                     TimesheetAuditLog[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([userId])
  @@index([projectId])
  @@index([organizationId, userId, workDate])
  @@index([organizationId, workDate])
  @@index([organizationId, workDate, status])
  @@index([organizationId, projectId, workDate])
  @@index([organizationId, status, workDate])
  @@index([status])
  @@map("timesheet_entries")
}

model AttendanceEvent {
  id                            String                    @id @default(uuid())

  employeeId                    String                    @map("employee_id")
  employee                      User                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  source                        AttendanceSource
  eventType                     AttendanceEventType       @map("event_type")
  origin                        AttendanceOrigin

  externalId                    String?                   @unique @map("external_id")

  timestamp                     DateTime                  @default(now())

  latitude                      Float?                    @map("latitude")
  longitude                     Float?                    @map("longitude")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([timestamp])
  @@index([employeeId, timestamp])
  @@map("attendance_events")
}

model TimesheetPeriodLock {
  id                            String                    @id @default(uuid())

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  periodStart                   DateTime                  @map("period_start")
  periodEnd                     DateTime                  @map("period_end")
  isLocked                      Boolean                   @default(false) @map("is_locked")
  lockedAt                      DateTime?                 @map("locked_at")
  lockedByMemberId              String?                   @map("locked_by_member_id")
  lockedBy                      Member?                   @relation("TimesheetPeriodLockedBy", fields: [lockedByMemberId], references: [id], onDelete: SetNull)
  unlockedAt                    DateTime?                 @map("unlocked_at")
  unlockedByMemberId            String?                   @map("unlocked_by_member_id")
  unlockedBy                    Member?                   @relation("TimesheetPeriodUnlockedBy", fields: [unlockedByMemberId], references: [id], onDelete: SetNull)
  unlockReason                  String?                   @map("unlock_reason")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([isLocked])
  @@map("timesheet_period_locks")
}

model TimesheetAuditLog {
  id                            String                    @id @default(uuid())

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actorMemberId                 String?                   @map("actor_member_id")
  actor                         Member?                   @relation("TimesheetAuditActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  targetUserId                  String?                   @map("target_user_id")
  targetUser                    User?                     @relation("TimesheetAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  timesheetEntryId              String?                   @map("timesheet_entry_id")
  timesheetEntry                TimesheetEntry?           @relation(fields: [timesheetEntryId], references: [id], onDelete: SetNull)

  action                        TimesheetAuditAction
  before                        Json?
  after                         Json?

  createdAt                     DateTime                  @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([actorMemberId])
  @@index([targetUserId])
  @@index([timesheetEntryId])
  @@index([action])
  @@map("timesheet_audit_logs")
}

model Attendance {
  id                            String                    @id @default(uuid())

  employeeId                    String                    @map("employee_id")
  employee                      User                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date                          DateTime                  @map("date")

  firstIn                       DateTime?                 @map("first_in")
  lastOut                       DateTime?                 @map("last_out")

  billableHours                 Float?                    @map("billable_hours")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("attendances")
}

model AttendancePolicy {
  id                            String                    @id @default(uuid())

  organizationId                String                    @unique @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  timezone                      String                    @default("Asia/Manila")
  autoClockOutEnabled           Boolean                   @default(true) @map("auto_clock_out_enabled")
  autoClockOutTime              String                    @default("18:00") @map("auto_clock_out_time")
  standardHoursPerDay           Float                     @default(8) @map("standard_hours_per_day")
  standardHoursPerWeek          Float                     @default(40) @map("standard_hours_per_week")
  maxHoursPerDay                Float                     @default(24) @map("max_hours_per_day")
  graceMinutes                  Int                       @default(15) @map("grace_minutes")
  lunchMinutes                  Int                       @default(60) @map("lunch_minutes")
  lunchIsPaid                   Boolean                   @default(false) @map("lunch_is_paid")
  overtimeAfterHoursPerDay      Float                     @default(8) @map("overtime_after_hours_per_day")
  minimumOvertimeMinutes        Int                       @default(30) @map("minimum_overtime_minutes")
  overtimeMultiplier            Float                     @default(1.25) @map("overtime_multiplier")
  restDayMultiplier             Float                     @default(1.30) @map("rest_day_multiplier")
  nightDifferentialMultiplier   Float                     @default(0.10) @map("night_differential_multiplier")
  nightDifferentialStart        String                    @default("22:00") @map("night_differential_start")
  nightDifferentialEnd          String                    @default("06:00") @map("night_differential_end")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("attendance_policies")
}

model Shift {
  id                            String                    @id @default(uuid())
  name                          String
  startTime                     String                    @map("start_time")
  endTime                       String                    @map("end_time")
  breakMinutes                  Int                       @default(60) @map("break_minutes")
  graceMinutes                  Int?                      @map("grace_minutes")
  crossesMidnight               Boolean                   @default(false) @map("crosses_midnight")
  isFlexible                    Boolean                   @default(false) @map("is_flexible")
  color                         String?                   @default("#6B7280")
  isActive                      Boolean                   @default(true) @map("is_active")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scheduleDays                  WeeklyScheduleDay[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("shifts")
}

model WeeklySchedule {
  id                            String                    @id @default(uuid())
  name                          String
  isDefault                     Boolean                   @default(false) @map("is_default")
  isActive                      Boolean                   @default(true) @map("is_active")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  days                          WeeklyScheduleDay[]
  teamAssignments               TeamScheduleAssignment[]
  employeeAssignments           EmployeeScheduleAssignment[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("weekly_schedules")
}

model WeeklyScheduleDay {
  id                            String                    @id @default(uuid())

  weeklyScheduleId              String                    @map("weekly_schedule_id")
  weeklySchedule                WeeklySchedule            @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)

  dayOfWeek                     DayOfWeek                 @map("day_of_week")
  isWorkingDay                  Boolean                   @default(true) @map("is_working_day")
  expectedSource                AttendanceSource?         @map("expected_source")

  // When false, lateness is not recorded for this day (e.g. a flexible WFH day).
  trackLateness                 Boolean                   @default(true) @map("track_lateness")

  shiftId                       String?                   @map("shift_id")
  shift                         Shift?                    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([weeklyScheduleId, dayOfWeek])
  @@index([weeklyScheduleId])
  @@map("weekly_schedule_days")
}

model Holiday {
  id                            String                    @id @default(uuid())
  name                          String
  date                          DateTime                  @map("date")
  type                          HolidayType               @default(REGULAR)
  isRecurring                   Boolean                   @default(false) @map("is_recurring")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, date, name])
  @@index([organizationId])
  @@index([organizationId, date])
  @@map("holidays")
}

model TeamScheduleAssignment {
  id                            String                    @id @default(uuid())

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId                        String                    @unique @map("team_id")
  team                          Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  weeklyScheduleId              String                    @map("weekly_schedule_id")
  weeklySchedule                WeeklySchedule            @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([weeklyScheduleId])
  @@map("team_schedule_assignments")
}

model EmployeeScheduleAssignment {
  id                            String                    @id @default(uuid())

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyScheduleId              String                    @map("weekly_schedule_id")
  weeklySchedule                WeeklySchedule            @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("employee_schedule_assignments")
}

