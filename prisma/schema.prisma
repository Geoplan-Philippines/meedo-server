// For fucks sake dipshit,
// Follow existing formatting, (alignment, spacing, ordering)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                            String                    @id @default(uuid())
  name                          String?
  email                         String                    @unique
  emailVerified                 Boolean                   @default(false) @map("is_email_verified")
  image                         String?                   @map("image_url")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  accounts                      Account[]
  faceProfiles                  FaceProfile[]
  invitations                   Invitation[]
  members                       Member[]
  sessions                      Session[]
  teamMembers                   TeamMember[]

  @@map("users")
}

model Session {
  id                            String                    @id @default(uuid())
  expiresAt                     DateTime                  @map("expires_at")
  token                         String                    @unique
  ipAddress                     String?                   @map("ip_address")
  userAgent                     String?                   @map("user_agent")
  activeOrganizationId          String?                   @map("active_organization_id")
  activeTeamId                  String?                   @map("active_team_id")

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")


  @@index([userId])
  @@map("sessions")
}

model Account {
  id                            String                    @id @default(uuid())
  accountId                     String                    @map("account_id")
  providerId                    String                    @map("provider_id")
  accessToken                   String?                   @map("access_token")
  refreshToken                  String?                   @map("refresh_token")
  idToken                       String?                   @map("id_token")
  accessTokenExpiresAt          DateTime?                 @map("access_token_expires_at")
  refreshTokenExpiresAt         DateTime?                 @map("refresh_token_expires_at")
  scope                         String?
  password                      String?

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id                            String                    @id @default(uuid())
  identifier                    String
  value                         String
  expiresAt                     DateTime                  @map("expires_at")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id                            String                    @id @default(uuid())
  name                          String
  slug                          String                    @unique
  prefix                        String?                   @unique
  logo                          String?
  metadata                      String?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  faceEmbeddings                FaceEmbedding[]
  faceProfiles                  FaceProfile[]
  invitations                   Invitation[]
  members                       Member[]
  ticketStatuses                TicketStatus[]
  ticketCategories              TicketCategory[]
  teams                         Team[]
  tickets                       Tickets[]
  projects                      Project[]
  slaPolicies                   SlaPolicy[]

  @@map("organizations")
}

model Team {
  id                            String                    @id @default(uuid())
  name                          String

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  teamMembers                   TeamMember[]
  invitations                   Invitation[]
  tickets                       Tickets[]

  @@map("teams")
  @@index([organizationId])
  @@unique([organizationId, name])
}

model TeamMember {
  id                            String                    @id @default(uuid())

  teamId                        String                    @map("team_id")
  team                          Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Member {
  id                            String                    @id @default(uuid())
  role                          String                    @default("member")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId                        String                    @map("user_id")
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  ticketAssignees               TicketAssignee[]
  ticketComments                TicketComment[]
  ticketActivities              TicketActivity[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id                            String                    @id @default(uuid())
  email                         String
  role                          String?
  status                        String                    @default("pending")
  expiresAt                     DateTime                  @map("expires_at")

  inviterId                     String                    @map("inviter_id")
  user                          User                      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId                        String?                   @map("team_id")
  team                          Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([email])
  @@index([teamId])
  @@map("invitations")
}

model FaceProfile {
  id                            String                    @id @default(uuid())
  status                        FaceProfileStatus         @default(PENDING)
  enrolledAt                    DateTime?                 @default(now()) @map("enrolled_at")
  disabledAt                    DateTime?                 @map("disabled_at")
  isArchived                    Boolean                   @default(false) @map("is_archived")
  organizationId                String                    @map("organization_id")
  userId                        String                    @map("user_id")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  faceEmbeddings                FaceEmbedding[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("face_profiles")
}

model FaceEmbedding {
  id                            String                    @id @default(uuid())
  provider                      FaceEmbeddingProvider     @default(DEEPFACE)
  model                         FaceEmbeddingModel
  embedding                     Unsupported("vector")
  imageUrl                      String?                   @map("image_url")
  qualityScore                  Float?                    @map("quality_score")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  faceProfileId                 String                    @map("face_profile_id")
  faceProfile                   FaceProfile               @relation(fields: [faceProfileId], references: [id], onDelete: Cascade)

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([faceProfileId])
  @@index([provider, model])
  @@index([isArchived])
  @@map("face_embeddings")
}

model TicketCategory {
  id                            String                    @id @default(uuid())
  name                          String
  description                   String?

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets                      Tickets[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("ticket_categories")
  @@index([organizationId])
  @@unique([organizationId, name])
}

model NewsletterSubscriber {
  id                            String                    @id @default(uuid())
  email                         String                    @unique
  name                          String?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

model Project {
  id                            String                    @id @default(uuid())
  workOrderNumber               String                    @map("work_order_number")
  customerName                  String                    @map("customer_name")
  status                        String
  total                         Float
  reportedDate                  DateTime?                 @map("reported_date")

  apptivoId                     String                    @unique @map("apptivo_id")
  organizationId                String                    @map("organization_id")

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets                       Tickets[]
  slaPolicies                   SlaPolicy[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("projects")
  
}

model Lead {
  id                            String                    @id @default(uuid())
  firstName                     String                    @map("first_name")
  lastName                      String                    @map("last_name")
  email                         String                    @unique
  company                       String?
  phoneNumber                   String?                   @map("phone_number")
  status                        LeadStatus                @default(PENDING)
  message                       String

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("leads")
}

model TicketStatus {
  id                            String                    @id @default(uuid())
  name                          String
  color                         String?                   @default("#6B7280")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets                       Tickets[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("ticket_status")
}

model Tickets {
  id                            String                    @id @default(uuid())
  ticketNumber                  Int                       @map("ticket_number")
  title                         String
  description                   String?
  priority                      TicketPriority            @default(MEDIUM)
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  teamId                        String?                   @map("team_id")
  projectId                     String?                   @map("project_id")
  categoryId                    String?                   @map("category_id")
  ticketStatusId                String?                   @map("ticket_status_id")

  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                       Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team                          Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignees                     TicketAssignee[]
  comments                      TicketComment[]
  activities                    TicketActivity[]

  ticketStatus                  TicketStatus?             @relation(fields: [ticketStatusId], references: [id], onDelete: SetNull)
  category                      TicketCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  firstRespondedAt              DateTime?                 @map("first_responded_at")
  resolvedAt                    DateTime?                 @map("resolved_at")
  dueDate                       DateTime?                 @map("due_date")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([ticketStatusId])
  @@index([categoryId])
  @@index([projectId])
  @@index([teamId])
  @@index([isArchived])
  @@unique([organizationId, ticketNumber])
  @@map("tickets")
}

model TicketAssignee {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  memberId                      String                    @map("member_id")
  member                        Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([ticketId, memberId])
  @@index([ticketId])
  @@index([memberId])
  @@map("ticket_assignees")
}

model SlaPolicy {
  id                            String                    @id @default(uuid())
  name                          String                    @db.VarChar(150)
  documentUrl                   String?                   @map("document_url") @db.VarChar(500)
  priority                      TicketPriority
  firstResponseMinutes          Int                       @map("first_response_minutes")
  resolutionMinutes             Int                       @map("resolution_minutes")
  businessHoursOnly             Boolean                   @default(false) @map("business_hours_only")
  isActive                      Boolean                   @default(true) @map("is_active")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  organizationId                String                    @map("organization_id")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId                     String?                   @map("project_id")
  project                       Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, projectId])
  @@index([organizationId])
  @@index([isActive])
  @@map("sla_policies")
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  COMMENTED
  ARCHIVED
  RESTORED
}

model TicketComment {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorMemberId                String?                   @map("author_member_id")
  author                        Member?                   @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)

  body                          String

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([authorMemberId])
  @@map("ticket_comments")
}

model TicketActivity {
  id                            String                    @id @default(uuid())

  ticketId                      String                    @map("ticket_id")
  ticket                        Tickets                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorMemberId                 String?                   @map("actor_member_id")
  actor                         Member?                   @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  type                          TicketActivityType
  meta                          Json?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([actorMemberId])
  @@map("ticket_activities")
}

enum FaceProfileStatus {
  PENDING
  ACTIVE
  DISABLED
  NEEDS_REENROLLMENT
}

enum FaceEmbeddingProvider {
  DEEPFACE
  INSIGHTFACE
}

enum FaceEmbeddingModel {
  ARCFACE
  FACENET
  VGG_FACE
}

enum LeadStatus {
  PENDING
  CONTACTED
  QUALIFIED
  LOST
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
