# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:8000
PORT=8000

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/meedo?schema=public"

# --------------------------------------------
# REQUIRED: BETTER AUTH SETTINGS
# --------------------------------------------
BETTER_AUTH_SECRET=hjkgdsgadsfvvyjtdhfdb

# --------------------------------------------
# OPTIONAL: SECURITY HEADER SETTINGS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --------------------------------------------
# REQUIRED: FACE RECOGNITION SERVICE
# --------------------------------------------
FACE_RECOGNITION_API_URL=http://localhost:8001/api/v1
FACE_RECOGNITION_API_TIMEOUT_MS=8000

# --------------------------------------------
# APPTIVO API SETTINGS
# --------------------------------------------
APPTIVO_API_RESOURCE=https://api2.apptivo.com/app/dao/v6/workorders?a=getAllByAdvancedSearch
APPTIVO_CUSTOMERS_API_RESOURCE=https://api2.apptivo.com/app/dao/v6/customers?a=getAll
APPTIVO_API_KEY=your_apptivo_api_key
APPTIVO_API_ACCESS_KEY=your_apptivo_access_key
# Max 500-record pages per Apptivo fetch; the sync fails if records remain past it (default 20)
APPTIVO_SYNC_MAX_PAGES=20

# --------------------------------------------
# CLOUDINARY SETTINGS
# --------------------------------------------
CLOUDINARY_API_KEY_SECRET=your_cloudinary_api_key_secret
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
PRESET_NAME=your_cloudinary_preset_name
CLOUDINARY_BASE_URL=your_cloudinary_base_url

# Socket.IO notifications use CORS_ALLOWED_ORIGINS above, with credentials and no wildcard.

# Optional exact database name required to run the seed against a non-local development database.
SEED_ALLOWED_DATABASE_NAME=
